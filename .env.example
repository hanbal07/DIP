# ============================================================================
# Document Intelligence Platform — Environment Configuration
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# All secrets must come from environment variables, never hardcoded.
# ============================================================================

# --- Core -------------------------------------------------------------------
APP_NAME=Document Intelligence Platform
ENVIRONMENT=development            # development | test | production
DEBUG=false
API_PREFIX=/api/v1
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# --- Security (REQUIRED to change in production) ----------------------------
# A long random string used to sign JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=change-me-in-production-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=1440   # 24 hours
ALGORITHM=HS256

# --- Database (PostgreSQL + pgvector) ----------------------------------------
# Async URL (application):
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/document_intelligence
# Sync URL (Alembic migrations; psycopg2):
DATABASE_URL_SYNC=postgresql+psycopg2://postgres:postgres@postgres:5432/document_intelligence

# --- Redis / background tasks ------------------------------------------------
REDIS_URL=redis://redis:6379/0
TASK_QUEUE_NAME=document-processing

# --- File storage ------------------------------------------------------------
UPLOAD_DIR=storage/uploads
EXPORT_DIR=storage/exports
MAX_UPLOAD_SIZE_BYTES=52428800     # 50 MB
MAX_PAGES=100
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,tiff,tif,bmp,gif,webp,docx,doc,txt,md,rtf

# --- OCR ---------------------------------------------------------------------
# Available engines: paddleocr | tesseract | mock  (mock = deterministic, for dev/tests)
OCR_ENGINE=mock
OCR_RENDER_DPI=200
OCR_LANG=eng
# TESSERACT_CMD=/usr/bin/tesseract

# --- AI provider -------------------------------------------------------------
# Providers: openai | anthropic | mock
# mock = deterministic provider for development & the automated test suite.
AI_PROVIDER=mock

# OpenAI (required for real embeddings and chat)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (optional; alternative chat provider — embeddings still need OpenAI)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

EMBEDDING_DIMENSIONS=1536          # must match OPENAI_EMBEDDING_MODEL

# --- Provider resilience -----------------------------------------------------
PROVIDER_TIMEOUT_SECONDS=60
PROVIDER_MAX_RETRIES=3

# --- Rate limiting (requests per minute per user) ----------------------------
RATE_LIMIT_RPM=60
RATE_LIMIT_CHAT_RPM=15

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=http://localhost:3000

# --- Frontend (used by Docker/CI, not the backend) ----------------------------
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
